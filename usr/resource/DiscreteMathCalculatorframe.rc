                    <flag>wxALL|wxEXPAND|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                    <border>2</border>
                    <option>1</option>
                    <object class="wxPanel" name="ID_TRIANGLES_BUTTONS_PANEL">
                      <style>wxTAB_TRAVERSAL</style>
                      <object class="wxGridSizer">
                        <cols>5</cols>
                        <rows>0</rows>
                        <vgap>0</vgap>
                        <hgap>0</hgap>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>2</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_TRIANGLES_PASCAL_BUTTON">
                            <label>Pascal</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Display the Pascal triangle - C(m,n) = C(m-1,n-1) + C(m-1,n),\nC(0,0) = 1, C(m,m) = 1]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>2</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_TRIANGLES_HOSOYA_BUTTON">
                            <label>Fibonacci</label>
                            <style/>
                            <tooltip>
                              <![CDATA[H(n,i) = F(i+1) * F(n-i+1), where F (k) is Fibonacci number k.\nThe first column and the diagonal are Fibonacci numbers]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>2</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_TRIANGLES_CATALAN_BUTTON">
                            <label>Catalan</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Each element is equal to the one above plus the one to the left. The sum of each row is equal to the last element of the next row and also equal to the Catalan number C(n)]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>2</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_TRIANGLES_SCHRODER_BUTTON">
                            <label>Schroder</label>
                            <style/>
                            <tooltip>
                              <![CDATA[S(n,k)=S(n,k-1)+S(n-1,k-1)+S(n-1,k),  n,k >= 0; (n,k) != (0,0),\nS(n,k) = 0, k < 0 or n < 0. The diagonal is the sequence of Schroder numbers.]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>2</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_TRIANGLES_BELL_BUTTON">
                            <label>Bell</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Begin the first row with the number one, and begin subsequent rows with last number of the previous row. Rows are filled out by adding the number in the preceding column to the number above it. The diagonal contains the sequence of Bell numbers.]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
