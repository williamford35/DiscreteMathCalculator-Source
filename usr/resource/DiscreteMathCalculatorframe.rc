                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_PERMUTATIONS_BUTTON">
                            <label>P(n,k)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute the permutation of n items\ntaken k at a time]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_COMBINATIONS_BUTTON">
                            <label>C(n,k)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute the number of combinations of n items\ntaken k at a time]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_FIBONACCI_BUTTON">
                            <label>Fibonacci(n)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute Fibonacci number n]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_CATALAN_BUTTON">
                            <label>C(n)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute Catalan number n - the number of full binary trees with n + 1 leaves and other applications]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_SCHRODER_BUTTON">
                            <label>S(n)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute Schroder number n - the number of lattice paths in the Cartesian plane that start at (0, 0), end at (n,n), contain no points above the line y=x, and are composed only of steps (0, 1), (1, 0), and (1, 1)]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_BELL_BUTTON">
                            <label>Bell(n)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute Bell number of n - the number of partitions of a set with n elements]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                        <object class="sizeritem">
                          <flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
                          <border>1</border>
                          <option>1</option>
                          <object class="wxButton" name="ID_COUNTING_AND_ENUMERATION_STIRLING_BUTTON">
                            <label>S(n,k)</label>
                            <style/>
                            <tooltip>
                              <![CDATA[Compute the Stirling number of the second kind - the number of ways to partition an n-element set into k subsets.]]>
                            </tooltip>
                            <bitmapposition>wxLEFT</bitmapposition>
                            <default>0</default>
                          </object>
                        </object>
                      </object>
                    </object>
                  </object>
