<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc">
  <object class="wxFrame" name="DiscreteMathCalculatorFrame">
    <title>DiscreteMathCalculator</title>
    <centered>1</centered>
    <style>wxDEFAULT_FRAME_STYLE|wxRESIZE_BORDER</style>
    <size>1100,850</size>
    <object class="wxPanel" name="ID_DISCRETE_MATH_CALCULATOR_PANEL">
      <style>wxTAB_TRAVERSAL</style>
      <object class="wxGridSizer">
        <cols>1</cols>
        <rows>0</rows>
        <vgap>0</vgap>
        <hgap>0</hgap>
        <object class="sizeritem">
          <flag>wxALL|wxEXPAND|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
          <border>1</border>
          <option>1</option>
          <object class="wxNotebook" name="ID_DISCRETE_MATH_CALCULATOR_NOTEBOOK">
            <style>wxBK_DEFAULT</style>
            <object class="notebookpage">
              <label>Big Integer Calculator</label>
              <selected>0</selected>
              <object class="wxPanel" name="ID_NUMBER_THEORETIC_PANEL">
                <style>wxTAB_TRAVERSAL</style>
                <object class="wxFlexGridSizer">
