<?xml version="1.0" encoding="utf-8" ?>
<resource xmlns="http://www.wxwidgets.org/wxxrc">
	<object class="wxDialog" name="SpellNumberDialog">
		<title>Spell Number</title>
		<centered>1</centered>
		<size>400,500</size>
		<style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER|wxRAISED_BORDER</style>
		<object class="wxFlexGridSizer">
			<cols>1</cols>
			<rows>2</rows>
			<growablecols>0</growablecols>
			<growablerows>1</growablerows>
			<object class="sizeritem">
				<object class="wxTextCtrl" name="ID_SPELL_NUMBER_TEXTCTRL">
					<size>400,450</size>
					<style>wxTE_MULTILINE|wxHSCROLL</style>
				</object>
				<flag>wxALL|wxEXPAND|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
				<border>1</border>
				<option>1</option>
			</object>
			<object class="sizeritem">
				<object class="wxButton" name="ID_SPELL_NUMBER_CLOSE_BUTTON">
					<label>Close</label>
				</object>
				<flag>wxALL|wxALIGN_RIGHT|wxALIGN_CENTER_VERTICAL</flag>
				<border>5</border>
				<option>1</option>
			</object>
		</object>
	</object>
</resource>
