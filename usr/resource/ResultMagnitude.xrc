<?xml version="1.0" encoding="utf-8" ?>
<resource xmlns="http://www.wxwidgets.org/wxxrc">
	<object class="wxDialog" name="ResultMagnitude">
		<title>Result Magnitude</title>
		<centered>1</centered>
		<size>-1,-1</size>
		<object class="wxFlexGridSizer">
			<cols>1</cols>
			<rows>2</rows>
			<growablerows>0</growablerows>
			<object class="sizeritem">
				<object class="wxPanel" name="ID_RESULT_MAGNITUDE_PANEL">
					<object class="wxBoxSizer">
						<object class="sizeritem">
							<object class="wxStaticBitmap" name="ID_RESULT_MAGNITUDE_STATICBITMAP">
#ifdef __APPLE__
								<bitmap>Contents/Resources/images/approxeq.png</bitmap>
#else
								<bitmap>./images/approxeq.png</bitmap>
#endif
							</object>
							<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
							<border>1</border>
							<option>1</option>
						</object>
						<object class="sizeritem">
							<object class="wxTextCtrl" name="ID_RESULT_MAGNITUDE_TEXTCTRL">
								<style>wxTE_READONLY</style>
							</object>
							<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
							<border>5</border>
							<option>8</option>
						</object>
					</object>
				</object>
				<flag>wxALL|wxALIGN_CENTER_HORIZONTAL|wxALIGN_CENTER_VERTICAL</flag>
				<border>5</border>
				<option>1</option>
			</object>
			<object class="sizeritem">
				<object class="wxButton" name="ID_CLOSE_BUTTON">
					<label>Close</label>
					<default>1</default>
				</object>
				<flag>wxALL|wxALIGN_RIGHT|wxALIGN_CENTER_VERTICAL</flag>
				<border>5</border>
				<option>1</option>
			</object>
		</object>
	</object>
</resource>
